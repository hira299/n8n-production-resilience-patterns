        "unit": "seconds"
      },
      "id": "a608fa88-9e3a-5993-8d20-1f95d2b99cd4",
      "name": "Wait for next window",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        220
      ],
      "webhookId": "14a3daf4-f6cf-53b1-896d-4edaa92eea20"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn [{ json: { sent: items.length, status_codes: items.map(i => i.json.statusCode) } }];\n"
      },
