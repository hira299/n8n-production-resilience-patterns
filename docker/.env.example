# Copy to .env and replace every value. Never commit .env.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Change if 5432 is already in use on the host.
POSTGRES_HOST_PORT=5432

# Generate with: openssl rand -hex 32
# Store it somewhere safe. Losing it makes saved n8n credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32

GENERIC_TIMEZONE=UTC
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# Hours of execution history to keep.
EXECUTIONS_DATA_MAX_AGE=168

# Pin a specific n8n version in production instead of "latest".
# N8N_IMAGE=docker.n8n.io/n8nio/n8n:<version>
